{
  "name": "mosaic-notes",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@mosaic/sdk": "file:../Mosaic/packages/sdk"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx tests/browser.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm --prefix ../Mosaic run app:validate -- ../Mosaic-Notes",
    "build": "npm --prefix ../Mosaic run app:build -- ../Mosaic-Notes",
    "package": "npm --prefix ../Mosaic run app:package -- ../Mosaic-Notes",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate && npm run package"
  }
}
